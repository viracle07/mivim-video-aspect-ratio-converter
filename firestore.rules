rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.data.keys()
          .hasOnly(['profile', 'jobs', 'dataVersion', 'contentUpdatedAt', 'syncedAt']);
      allow update: if owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['profile', 'jobs', 'dataVersion', 'contentUpdatedAt', 'syncedAt']);
    }

    match /users/{userId}/conversions/{jobId} {
      allow read, create, update, delete: if owns(userId);
    }

    match /adminLogs/{logId} {
      allow read, write: if signedIn() && request.auth.token.admin == true;
    }
  }
}
